{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rouletabille-fr",
  "compatibility_date": "2025-10-28",
  "main": "src/worker.ts",

  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },

  "triggers": {
    "crons": ["*/30 * * * *", "0 3 * * 1"]
  },

  "workers_dev": true,
  "preview_urls": true,

  "routes": [
    {
      "pattern": "rouletabille.fr",
      "custom_domain": true
    }
  ]
}
