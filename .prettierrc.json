{
  "endOfLine": "auto",
  "semi": true,
  "singleQuote": true,
  "overrides": [
    {
      "files": ["**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ["**/*.webc"],
      "options": {
        "parser": "html",
        "printWidth": 9999
      }
    }
  ]
}
