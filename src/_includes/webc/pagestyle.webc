<style>
  /* =====================
   Global Design Tokens
   ===================== */

  :root {
    /* Primitive palette — Garden & Path (raw RGB triplets for rgba() composition) */
    --palette-nav-bg: 212, 228, 210; /* #D4E4D2 */
    --palette-nav-fg: 20, 38, 18; /* #142612 */
    --palette-nav-dim: 80, 108, 78; /* #506C4E */
    --palette-content-bg: 248, 246, 240; /* #F8F6F0 */
    --palette-content-fg: 28, 38, 22; /* #1C2616 */
    --palette-content-surface: 234, 228, 215; /* #EAE4D7 */
    --palette-accent: 172, 58, 20; /* #AC3A14 */
    --palette-accent-secondary: 45, 85, 50; /* #2D5532 */
    --palette-page-bg: 140, 165, 130; /* #8CA582 */
    --palette-bright: 254, 254, 250; /* #FEFEFA */

    /* Type scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.85rem;
    --fs-base: 1rem;
    --fs-md: 1.1rem;
    --fs-lg: 1.3rem;
    --fs-xl: 1.5rem;
    --fs-xxl: 2rem;
    --fs-hero: 5rem;

    /* Fonts */
    --font-mono: monospace;
    --font-body: system-ui, sans-serif;

    /* Layout */
    --sidebar-w: 300px;

    /* Header geometry — shared with header component */
    --logo-size: 4.5rem;
    --header-pad-block: 0.5rem;
    --safe-top: max(0.5rem, env(safe-area-inset-top));
    --safe-right: max(1rem, env(safe-area-inset-right));
    --safe-bottom: max(2rem, env(safe-area-inset-bottom));
    --safe-left: max(1rem, env(safe-area-inset-left));
  }

  /* =====================
   Base reset
   ===================== */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background-color: rgb(var(--palette-page-bg));
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px), radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 4px 4px;
    background-position:
      0 0,
      2px 2px;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    background-color: rgb(var(--palette-content-bg));
    color: rgb(var(--palette-content-fg));
    font-family: var(--font-body);
    font-size: var(--fs-base);
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  /* =====================
   Main content area
   ===================== */

  main {
    flex: 1;
    max-width: 100ch;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--safe-left) var(--safe-right);
  }

  article {
    padding-block: 2rem;
  }

  /* Headings */
  main h1 {
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: bold;
    color: rgb(var(--palette-accent));
    margin-block: 0 1.5rem;
    line-height: 1.2;
  }

  /* Body text */
  main p {
    line-height: 1.7;
    margin-block: 0.75rem;
  }

  main ul,
  main ol {
    padding-inline-start: 1.5rem;
    line-height: 1.7;
  }

  main li {
    margin-block: 0.3rem;
  }

  /* Links */
  a {
    color: rgb(var(--palette-accent));
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration: none;
  }

  /* =====================
   Desktop layout (≥800px): two-column grid
   ===================== */

  @media (min-width: 800px) {
    body {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      max-width: calc(var(--sidebar-w) + 100ch);
      margin-inline: auto;
      box-shadow: 16px 0 16px -16px rgba(0, 0, 0, 0.5);
    }
  }

  /* Right-column wrapper — explicit display needed (custom elements default to inline) */
  site-content {
    display: flex;
    flex-direction: column;
  }

  /* =====================
   Mobile menu open: lock body scroll
   ===================== */

  @media (max-width: 799px) {
    body:has(#nav-toggle:checked) {
      overflow: hidden;
    }
  }

  /* =====================
   Unicycle icon: crank drive on hover
   ===================== */

  /* Both turn on the axle: the cranks all the way round, the uni rocking */
  .unicycle-body,
  .unicycle-cranks {
    transform-box: view-box;
    transform-origin: 400.524px 717.383px; /* wheel hub, in viewBox units */
  }

  .unicycle-pedal {
    transform-box: fill-box;
    transform-origin: center;
  }

  .unicycle-wheel {
    transform-box: view-box;
    transform-origin: 400.524px 717.383px; /* wheel hub, in viewBox units */
  }

  /* One lean per crank revolution, peaking as each pedal passes the bottom. */
  svg:hover .unicycle-body {
    animation: unicycle-wobble 0.75s ease-in-out -0.375s infinite alternate;
  }

  svg:hover .unicycle-cranks {
    animation: unicycle-crank 1.5s linear infinite;
  }

  svg:hover .unicycle-pedal {
    animation: unicycle-pedal 1.5s linear infinite;
  }

  @keyframes unicycle-wobble {
    from {
      transform: rotate(-2.5deg);
    }
    to {
      transform: rotate(2.5deg);
    }
  }

  @keyframes unicycle-crank {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes unicycle-pedal {
    to {
      transform: rotate(-1turn);
    }
  }

  /* =====================
   Unicycle icon: click tricks (random hop or idle, one-shot)
   ===================== */

  svg.trick-hop {
    transform-box: border-box;
    transform-origin: bottom;
    animation: unicycle-hop 1.4s ease-in-out;
  }

  /* Straighten up before hopping (instead of the riding lean), settle back at landing. */
  svg.trick-hop .unicycle-body {
    animation: unicycle-hop-straighten 1.4s ease-in-out;
  }

  /* Held level for the hops: no crank spin, pedals rotated flat against the horizontal crank. */
  svg.trick-hop .unicycle-cranks {
    animation: none;
    transform: rotate(-25deg);
  }

  svg.trick-hop .unicycle-pedal {
    animation: none;
  }

  /* Each pedal is drawn at its own baked-in angle, so each needs its own correction. */
  svg.trick-hop .unicycle-pedal-a {
    transform: rotate(58deg);
  }

  svg.trick-hop .unicycle-pedal-b {
    transform: rotate(52deg);
  }

  /* Squash before each launch; the third crunch is deepest, the third bounce highest. */
  @keyframes unicycle-hop {
    0%,
    100% {
      transform: scaleY(1) scaleX(1) translateY(0);
    }
    6% {
      transform: scaleY(0.85) scaleX(1.1) translateY(2%);
    }
    20% {
      transform: scaleY(1.05) scaleX(0.95) translateY(-18%);
    }
    34% {
      transform: scaleY(0.85) scaleX(1.1) translateY(2%);
    }
    50% {
      transform: scaleY(1.05) scaleX(0.95) translateY(-26%);
    }
    64% {
      transform: scaleY(0.8) scaleX(1.15) translateY(3%);
    }
    84% {
      transform: scaleY(1.08) scaleX(0.92) translateY(-38%);
    }
  }

  @keyframes unicycle-hop-straighten {
    0% {
      transform: rotate(0deg);
    }
    8%,
    90% {
      transform: rotate(-25deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  svg.trick-idle .unicycle-body {
    animation: unicycle-idle-rock 2.4s ease-in-out 2;
  }

  /* Fixed-gear drive: wheel and cranks/pedals always turn together. */
  svg.trick-idle .unicycle-wheel,
  svg.trick-idle .unicycle-cranks,
  svg.trick-idle .unicycle-pedal {
    animation: unicycle-idle-drive 2.4s ease-in-out 2;
  }

  @keyframes unicycle-idle-rock {
    0%,
    100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }

  @keyframes unicycle-idle-drive {
    0%,
    100% {
      transform: rotate(-180deg);
    }
    50% {
      transform: rotate(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg:hover .unicycle-body,
    svg:hover .unicycle-cranks,
    svg:hover .unicycle-pedal,
    svg.trick-hop,
    svg.trick-hop .unicycle-body,
    svg.trick-hop .unicycle-cranks,
    svg.trick-idle .unicycle-body,
    svg.trick-idle .unicycle-wheel,
    svg.trick-idle .unicycle-cranks,
    svg.trick-idle .unicycle-pedal {
      animation: none;
    }
  }
</style>
