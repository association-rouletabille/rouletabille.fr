<style>
  /* =====================
   Global Design Tokens
   ===================== */

  :root {
    /* Primitive palette — Garden & Path (raw RGB triplets for rgba() composition) */
    --palette-nav-bg: 212, 228, 210; /* #D4E4D2 */
    --palette-nav-fg: 20, 38, 18; /* #142612 */
    --palette-nav-dim: 80, 108, 78; /* #506C4E */
    --palette-content-bg: 248, 246, 240; /* #F8F6F0 */
    --palette-content-fg: 28, 38, 22; /* #1C2616 */
    --palette-content-surface: 234, 228, 215; /* #EAE4D7 */
    --palette-accent: 172, 58, 20; /* #AC3A14 */
    --palette-accent-secondary: 45, 85, 50; /* #2D5532 */
    --palette-page-bg: 140, 165, 130; /* #8CA582 */
    --palette-bright: 254, 254, 250; /* #FEFEFA */

    /* Type scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.85rem;
    --fs-base: 1rem;
    --fs-md: 1.1rem;
    --fs-lg: 1.3rem;
    --fs-xl: 1.5rem;
    --fs-xxl: 2rem;
    --fs-hero: 5rem;

    /* Fonts */
    --font-mono: monospace;
    --font-body: system-ui, sans-serif;

    /* Layout */
    --sidebar-w: 300px;

    /* Header geometry — shared with header component */
    --logo-size: 4.5rem;
    --header-pad-block: 0.5rem;
    --safe-top: max(0.5rem, env(safe-area-inset-top));
    --safe-right: max(1rem, env(safe-area-inset-right));
    --safe-bottom: max(2rem, env(safe-area-inset-bottom));
    --safe-left: max(1rem, env(safe-area-inset-left));
  }

  /* =====================
   Base reset
   ===================== */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background-color: rgb(var(--palette-page-bg));
    background-image: radial-gradient(rgba(0, 0, 0, 0.08) 1px, transparent 1px), radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 4px 4px;
    background-position:
      0 0,
      2px 2px;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    background-color: rgb(var(--palette-content-bg));
    color: rgb(var(--palette-content-fg));
    font-family: var(--font-body);
    font-size: var(--fs-base);
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  /* =====================
   Main content area
   ===================== */

  main {
    flex: 1;
    max-width: 100ch;
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--safe-left) var(--safe-right);
  }

  article {
    padding-block: 2rem;
  }

  /* Headings */
  main h1 {
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: bold;
    color: rgb(var(--palette-accent));
    margin-block: 0 1.5rem;
    line-height: 1.2;
  }

  /* Body text */
  main p {
    line-height: 1.7;
    margin-block: 0.75rem;
  }

  main ul,
  main ol {
    padding-inline-start: 1.5rem;
    line-height: 1.7;
  }

  main li {
    margin-block: 0.3rem;
  }

  /* Links */
  a {
    color: rgb(var(--palette-accent));
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration: none;
  }

  /* =====================
   Desktop layout (≥800px): two-column grid
   ===================== */

  @media (min-width: 800px) {
    body {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr;
      max-width: calc(var(--sidebar-w) + 100ch);
      margin-inline: auto;
      box-shadow: 16px 0 16px -16px rgba(0, 0, 0, 0.5);
    }
  }

  /* Right-column wrapper — explicit display needed (custom elements default to inline) */
  site-content {
    display: flex;
    flex-direction: column;
  }

  /* =====================
   Mobile menu open: lock body scroll
   ===================== */

  @media (max-width: 799px) {
    body:has(#nav-toggle:checked) {
      overflow: hidden;
    }
  }

  /* =====================
   Unicycle icon: crank drive on hover, trick hop on click
   ===================== */

  /* Lengths are in the icon's own viewBox units, so the trick looks identical
     at any rendered size. Selectors stay at `svg:hover` specificity because
     404.webc parks its copy on its side by overriding them. */
  .icon-unicycle {
    --hub: 400.524px 717.383px;
    --contact-patch: 400.524px 1036px;

    --spin-duration: 1.5s;
    /* The cranks coast to a stop over a fixed budget, so the trick lasts the
       same time wherever the spin happened to be interrupted. The rider sits
       up during that same window, so keep the two in step. */
    --crank-stop-duration: 0.35s;
    --trick-duration: 1.6s;

    /* The seat tube is drawn 30.8deg off vertical; this sits the rider up
       almost straight while keeping a little of the riding lean. */
    --lean: -25deg;
    --hop-small: -170px;
    --hop-big: -540px;

    /* The hop and the squash both reach outside the viewBox. */
    overflow: visible;
  }

  /* Both turn on the axle: the cranks all the way round, the uni rocking */
  .unicycle-frame,
  .unicycle-cranks {
    transform-box: view-box;
    transform-origin: var(--hub);
  }

  .unicycle-hop {
    transform-box: view-box;
    transform-origin: var(--contact-patch);
  }

  .unicycle-pedal {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* One guard for the whole feature, so no rule has to be repeated to cancel it. */
  @media (prefers-reduced-motion: no-preference) {
    svg:hover:where(:not(.trick)) .unicycle-cranks {
      animation: unicycle-crank var(--spin-duration) linear infinite;
    }

    svg:hover:where(:not(.trick)) .unicycle-pedal {
      animation: unicycle-pedal var(--spin-duration) linear infinite;
    }

    /* One lean per crank revolution, peaking as each pedal passes the bottom. */
    svg:hover:where(:not(.trick)) .unicycle-frame {
      animation: unicycle-wobble calc(var(--spin-duration) / 2) ease-in-out calc(var(--spin-duration) / -4) infinite alternate;
    }

    /* Click: the rider sits up while the cranks coast to rest, then hops.
       `both` holds each phase's end pose for the rest of the trick. */
    svg.trick .unicycle-cranks {
      animation: unicycle-crank-stop var(--crank-stop-duration) ease-out both;
    }

    svg.trick .unicycle-pedal {
      animation: unicycle-pedal-stop var(--crank-stop-duration) ease-out both;
    }

    svg.trick .unicycle-frame {
      animation: unicycle-lean var(--trick-duration) linear both;
    }

    svg.trick .unicycle-hop {
      animation:
        unicycle-hop var(--trick-duration) linear both,
        unicycle-squash var(--trick-duration) linear both;
    }
  }

  @keyframes unicycle-crank {
    from {
      rotate: 0turn;
    }
    to {
      rotate: 1turn;
    }
  }

  @keyframes unicycle-pedal {
    from {
      rotate: 0turn;
    }
    to {
      rotate: -1turn;
    }
  }

  @keyframes unicycle-wobble {
    from {
      rotate: -2.5deg;
    }
    to {
      rotate: 2.5deg;
    }
  }

  /* footer.webc sets --crank-from to wherever the spin got to; the 1turn
     fallback means a click without a prior hover moves nothing. 1turn is the
     authored pose: right crank slightly below horizontal. */
  @keyframes unicycle-crank-stop {
    from {
      rotate: var(--crank-from, 1turn);
    }
    to {
      rotate: 1turn;
    }
  }

  @keyframes unicycle-pedal-stop {
    from {
      rotate: calc(-1 * var(--crank-from, 1turn));
    }
    to {
      rotate: -1turn;
    }
  }

  /* Sit up while the cranks are still coasting (22% of 1.6s ~= the 0.35s
     wind-down), hold it through all three landings, then settle back. */
  @keyframes unicycle-lean {
    0% {
      rotate: 0deg;
      animation-timing-function: ease-out;
    }
    22%,
    90% {
      rotate: var(--lean);
      animation-timing-function: ease-in-out;
    }
    100% {
      rotate: 0deg;
    }
  }

  /* Two warm-up hops, then the real one. Each takeoff eases out and each
     descent eases in, so the arcs read as ballistic. */
  @keyframes unicycle-hop {
    0%,
    28% {
      translate: 0 0;
      animation-timing-function: ease-out;
    }
    34% {
      translate: 0 var(--hop-small);
      animation-timing-function: ease-in;
    }
    40%,
    46% {
      translate: 0 0;
      animation-timing-function: ease-out;
    }
    52% {
      translate: 0 var(--hop-small);
      animation-timing-function: ease-in;
    }
    58%,
    68% {
      translate: 0 0;
      animation-timing-function: ease-out;
    }
    79% {
      translate: 0 var(--hop-big);
      animation-timing-function: ease-in;
    }
    90%,
    100% {
      translate: 0 0;
    }
  }

  /* Squash and stretch, on its own animation so it composes with the hop
     instead of having to share its keyframes. */
  @keyframes unicycle-squash {
    0%,
    22% {
      scale: 1 1;
    }
    26% {
      scale: 1.1 0.85; /* crouch */
    }
    30% {
      scale: 0.96 1.05; /* takeoff */
    }
    36% {
      scale: 1 1; /* apex */
    }
    41% {
      scale: 1.1 0.85; /* landing, straight into the next crouch */
    }
    48% {
      scale: 0.96 1.05;
    }
    54% {
      scale: 1 1;
    }
    59% {
      scale: 1.1 0.85;
    }
    65% {
      scale: 1.16 0.8; /* deeper crouch before the big one */
    }
    70% {
      scale: 0.94 1.08;
    }
    80% {
      scale: 1 1;
    }
    91% {
      scale: 1.18 0.78; /* impact */
    }
    96%,
    100% {
      scale: 1 1;
    }
  }
</style>
