<style>
/* =====================
   Global Design Tokens
   ===================== */

:root {
  /* Primitive palette (raw RGB triplets for rgba() composition) */
  --palette-cream: 244, 240, 229;
  --palette-dark: 37, 37, 37;
  --palette-light: 239, 239, 239;
  --palette-near-black: 14, 14, 14;
  --palette-accent: 224, 92, 0;
  --palette-muted: 85, 85, 85;
  --palette-white: 254, 254, 254;

  /* Type scale */
  --fs-xs: 0.75rem;
  --fs-sm: 0.85rem;
  --fs-base: 1rem;
  --fs-md: 1.1rem;
  --fs-lg: 1.3rem;
  --fs-xl: 1.5rem;
  --fs-xxl: 2rem;
  --fs-hero: 5rem;

  /* Fonts */
  --font-mono: monospace;
  --font-body: system-ui, sans-serif;

  /* Layout */
  --sidebar-w: 300px;

  /* Header geometry — shared with header component via CSS lazy substitution:
     overriding --logo-size on any ancestor auto-corrects --header-h on descendants */
  --logo-size: 4.5rem;
  --header-pad-block: 0.5rem;
  --safe-top: max(0.5rem, env(safe-area-inset-top));
  --safe-right: max(1rem, env(safe-area-inset-right));
  --safe-bottom: max(2rem, env(safe-area-inset-bottom));
  --safe-left: max(1rem, env(safe-area-inset-left));
  --header-h: calc(var(--logo-size) + var(--header-pad-block) + var(--safe-top));
}

/* =====================
   Base reset
   ===================== */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  background: linear-gradient(
    to right,
    rgb(var(--palette-cream)) calc(50vw - 150px - 50ch),
    rgb(var(--palette-dark)) calc(50vw - 150px - 50ch)
  );
}

body {
  margin: 0;
  background-color: rgb(var(--palette-dark));
  color: rgb(var(--palette-light));
  font-family: var(--font-body);
  font-size: var(--fs-base);
  line-height: 1.6;
  overflow-wrap: break-word;
}

/* =====================
   Main content area
   ===================== */

main {
  flex: 1;
  max-width: 100ch;
  width: 100%;
  margin-inline: auto;
  padding-inline: var(--safe-left) var(--safe-right);
  padding-block: 2rem;
}

/* Headings */
main h1 {
  font-family: var(--font-mono);
  font-size: var(--fs-xl);
  font-weight: bold;
  color: rgb(var(--palette-accent));
  margin-block: 0 1.5rem;
  line-height: 1.2;
}

main h2 {
  font-family: var(--font-mono);
  font-size: var(--fs-lg);
  font-weight: bold;
  color: rgb(var(--palette-accent));
  margin-block: 2rem 0.75rem;
  line-height: 1.3;
}

main h3 {
  font-family: var(--font-mono);
  font-size: var(--fs-md);
  font-weight: bold;
  color: rgba(var(--palette-accent), 0.85);
  margin-block: 1.5rem 0.5rem;
}

/* Body text */
main p {
  line-height: 1.7;
  margin-block: 0.75rem;
}

main ul,
main ol {
  padding-inline-start: 1.5rem;
  line-height: 1.7;
}

main li {
  margin-block: 0.3rem;
}

/* Links */
main a {
  color: rgb(var(--palette-accent));
  text-underline-offset: 0.2em;
}

main a:hover {
  text-decoration: none;
}

/* Sections */
main section {
  margin-block: 2.5rem;
}

main section:first-child {
  margin-top: 0;
}

/* =====================
   Desktop layout (≥800px): two-column grid
   ===================== */

@media (min-width: 800px) {
  body {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    min-height: 100dvh;
    max-width: calc(var(--sidebar-w) + 100ch);
    margin-inline: auto;
  }
}

/* Right-column wrapper — explicit display needed (custom elements default to inline) */
site-content {
  display: flex;
  flex-direction: column;
}

/* =====================
   Mobile menu open: lock body scroll
   ===================== */

@media (max-width: 799px) {
  body:has(#nav-toggle:checked) {
    overflow: hidden;
  }
}
</style>
