<style>
html,
body {
	margin: auto;
	padding-left: 20px;
	padding-right: 20px;
	max-width: 100ch;
	background-color: #252525;
	word-wrap: break-word;
	overflow-wrap: break-word;
	color: #efefef;
}

body {
	padding-top: env(safe-area-inset-top);
}

body::before {
	content: '';
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	height: env(safe-area-inset-top);
	background-color: #252525;
	z-index: 9999;
}
</style>
