<style>
/* =====================
   Global Design Tokens
   ===================== */

:root {
  /* Primitive palette (raw RGB triplets for rgba() composition) */
  --palette-cream: 244, 240, 229;
  --palette-dark: 37, 37, 37;
  --palette-light: 239, 239, 239;
  --palette-near-black: 14, 14, 14;
  --palette-accent: 224, 92, 0;
  --palette-muted: 85, 85, 85;
  --palette-white: 254, 254, 254;

  /* Type scale (rem-based, no vh/vw) */
  --fs-xs: 0.75rem;
  --fs-sm: 0.85rem;
  --fs-base: 1rem;
  --fs-md: 1.1rem;
  --fs-lg: 1.3rem;
  --fs-xl: 1.5rem;
  --fs-xxl: 2rem;
  --fs-hero: 5rem;

  /* Shared tokens */
  --font-mono: monospace;
  --font-body: system-ui, sans-serif;
}

/* =====================
   Base
   ===================== */

html {
  background-color: rgb(var(--palette-dark));
}

body {
  margin: 0;
  background-color: rgb(var(--palette-dark));
  word-wrap: break-word;
  overflow-wrap: break-word;
  color: rgb(var(--palette-light));
  font-family: var(--font-body);
  font-size: var(--fs-base);
  line-height: 1.6;
}

/* =====================
   Main content area
   ===================== */

main {
  max-width: 100ch;
  margin-inline: auto;
  padding-inline: 1rem;
  padding-inline-start: max(1rem, env(safe-area-inset-left));
  padding-inline-end: max(1rem, env(safe-area-inset-right));
  padding-block: 2rem;
  padding-bottom: max(2rem, env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* Headings */
main h1 {
  font-family: var(--font-mono);
  font-size: var(--fs-xl);
  font-weight: bold;
  color: rgb(var(--palette-accent));
  margin-block: 0 1.5rem;
  line-height: 1.2;
}

main h2 {
  font-family: var(--font-mono);
  font-size: var(--fs-lg);
  font-weight: bold;
  color: rgb(var(--palette-accent));
  margin-block: 2rem 0.75rem;
  line-height: 1.3;
}

main h3 {
  font-family: var(--font-mono);
  font-size: var(--fs-md);
  font-weight: bold;
  color: rgba(var(--palette-accent), 0.85);
  margin-block: 1.5rem 0.5rem;
}

/* Body text */
main p {
  line-height: 1.7;
  margin-block: 0.75rem;
}

main ul,
main ol {
  padding-inline-start: 1.5rem;
  line-height: 1.7;
}

main li {
  margin-block: 0.3rem;
}

/* Links */
main a {
  color: rgb(var(--palette-accent));
  text-underline-offset: 0.2em;
}

main a:hover {
  text-decoration: none;
}

/* Sections */
main section {
  margin-block: 2.5rem;
}

main section:first-child {
  margin-top: 0;
}

/* =====================
   Desktop layout (≥800px): sidebar grid
   ===================== */

@media (min-width: 800px) {
  body {
    display: grid;
    grid-template-columns: 300px 1fr;
    min-height: 100dvh;
    max-width: calc(300px + 100ch);
    margin-inline: auto;
  }

  header {
    grid-column: 1;
  }

  content {
    grid-column: 2;
    margin-inline: 0;
    padding-inline: 2rem;
    padding-right: max(2rem, env(safe-area-inset-right));
  }
}
</style>
