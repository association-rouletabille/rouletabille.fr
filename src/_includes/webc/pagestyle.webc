<style>
html {
	background-color: #252525;
}

body {
	margin: 0;
	background-color: #252525;
	word-wrap: break-word;
	overflow-wrap: break-word;
	color: #efefef;
	padding-top: env(safe-area-inset-top);
}

body::before {
	content: '';
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	height: env(safe-area-inset-top);
	background-color: #252525;
	z-index: 9999;
}

main {
	max-width: 100ch;
	margin-inline: auto;
	padding-inline: 1rem;
	padding-block: 1rem;
	box-sizing: border-box;
}

@media (min-width: 800px) {
	body {
		display: grid;
		grid-template-columns: 220px 1fr;
		grid-template-rows: 1fr auto;
		min-height: 100vh;
	}

	header {
		grid-column: 1;
		grid-row: 1 / 3;
	}

	main {
		grid-column: 2;
		grid-row: 1;
		margin-inline: 0;
		padding-inline: 2rem;
	}

	footer {
		grid-column: 2;
		grid-row: 2;
	}
}
</style>
