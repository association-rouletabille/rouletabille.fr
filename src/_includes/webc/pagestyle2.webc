<style>
  /* =====================
   Global Design Tokens — Experimental top-bar layout
   ===================== */

  :root {
    /* Navigation bar colors (usage-based names) */
    --color-topbar-bg: 160, 28, 36; /* #A01C24  cherry red */
    --color-topbar-text: 255, 248, 240; /* #FFF8F0  warm cream */
    --color-topbar-text-hover: 255, 255, 255; /* #FFFFFF  white */
    --color-subbar-bg: 255, 248, 240; /* #FFF8F0  cream */
    --color-logo-circle: 160, 28, 36; /* #A01C24  circle behind logo */
    --color-logo-fill: 255, 248, 240; /* #FFF8F0  logo on circle */

    /* Content zone — reused from existing palette */
    --palette-content-bg: 15, 23, 42; /* #0F172A */
    --palette-content-fg: 226, 232, 240; /* #E2E8F0 */
    --palette-accent: 56, 189, 248; /* #38BDF8 */
    --palette-content-surface: 30, 41, 59; /* #1E293B */
    --palette-page-bg: 100, 116, 139; /* #64748B */

    /* Type scale */
    --fs-xs: 0.75rem;
    --fs-sm: 0.85rem;
    --fs-base: 1rem;
    --fs-md: 1.1rem;
    --fs-lg: 1.3rem;
    --fs-xl: 1.5rem;
    --fs-xxl: 2rem;
    --fs-hero: 5rem;

    /* Fonts */
    --font-mono: monospace;
    --font-body: system-ui, sans-serif;

    /* Logo geometry */
    --logo-size: 5rem;
  }

  /* =====================
   Base reset
   ===================== */

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: rgb(var(--palette-page-bg));
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background-color: rgb(var(--palette-content-bg));
    color: rgb(var(--palette-content-fg));
    font-family: var(--font-body);
    font-size: var(--fs-base);
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  /* =====================
   Main content area
   ===================== */

  main {
    flex: 1;
    max-width: 100ch;
    width: 100%;
    margin-inline: auto;
    padding-inline: max(1rem, env(safe-area-inset-left)) max(1rem, env(safe-area-inset-right));
    padding-block: 2rem;
  }

  /* Headings */
  main h1 {
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: bold;
    color: rgb(var(--palette-accent));
    margin-block: 0 1.5rem;
    line-height: 1.2;
  }

  /* Body text */
  main p {
    line-height: 1.7;
    margin-block: 0.75rem;
  }

  main ul,
  main ol {
    padding-inline-start: 1.5rem;
    line-height: 1.7;
  }

  main li {
    margin-block: 0.3rem;
  }

  /* Links */
  a {
    color: rgb(var(--palette-accent));
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration: none;
  }

  /* Right-column wrapper — explicit display needed (custom elements default to inline) */
  site-content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
</style>
