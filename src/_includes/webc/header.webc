<header webc:root="override">
  <a href="/" class="logo-link" aria-label="Accueil">
    <icon name="logo"></icon>
    <div class="site-name-group">
      <span class="site-name">Monocycle</span>
      <span class="site-subtitle">Paris / Île de France</span>
    </div>
  </a>

  <!-- Hidden checkbox — pure-CSS toggle, no JS -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">

  <!-- Hamburger (three bars): visible on mobile only -->
  <label for="nav-toggle" class="hamburger" aria-label="Menu">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <!-- Navigation: same HTML for sidebar (desktop) and overlay (mobile) -->
  <nav aria-label="Navigation principale">
    <ul>
      <li><a href="/association">L'association</a></li>
      <li class="nav-section-start"><a href="/initiations-monocycle-gratuites">Initiations gratuites</a></li>
      <li><a href="/balades-du-mardi-soir">Balades du Mardi Soir</a></li>
      <li><a href="/trial-street-flat">Trial, street &amp; flat</a></li>
      <li><a href="/roule-ton-caillou">Roule Ton Caillou</a></li>
      <li class="nav-section-start"><a href="/tutoriels-et-resources">Tutoriels et resources</a></li>
      <li class="nav-section-start"><a href="/adhesion">Adh&eacute;rer</a></li>
    </ul>
    <social>
      <a href="mailto:association.rouletabille@gmail.com?subject=Contact%20depuis%20le%20site%20web">
        <icon name="email"></icon>
      </a>
      <a href="https://www.instagram.com/rtb_monocycle" target="_blank" rel="noopener noreferrer">
        <icon name="Instagram"></icon>
      </a>
      <a href="https://www.facebook.com/rouletabillemonocycleparis" target="_blank" rel="noopener noreferrer">
        <icon name="2023_Facebook_icon"></icon>
      </a>
    </social>
  </nav>

</header>

<style webc:scoped>
/* =====================
   Tokens
   ===================== */

:host {
  /* Derived from global :root palette tokens */
  --c-header-bg: rgb(var(--palette-cream));
  --c-header-fg: rgba(var(--palette-near-black), 1);
  --c-header-accent: rgb(var(--palette-accent));
  --c-header-muted: rgb(var(--palette-muted));
  --c-header-divider: rgba(var(--palette-near-black), 0.15);
  --header-font: var(--font-mono);
  --logo-size: 4.5rem;
  --header-pad-block: 0.5rem;
  --header-pad-inline: 1rem;
}

/* =====================
   Shared
   ===================== */

:host {
  background-color: var(--c-header-bg);
  color: var(--c-header-fg);
}

.nav-toggle {
  display: none;
}

.logo-link {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--c-header-fg);
  text-decoration: none;
  flex-shrink: 0;
}

.logo-link svg {
  width: var(--logo-size);
  height: var(--logo-size);
  display: block;
}

.site-name-group {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
}

.site-name {
  font-family: var(--header-font);
  font-size: 1.3rem;
  font-weight: bold;
  line-height: 1.2;
}

.site-subtitle {
  font-family: var(--header-font);
  font-size: 0.85rem;
  font-weight: normal;
  color: var(--c-header-muted);
  line-height: 1.3;
  margin-top: 0.25rem;
}

nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

nav li.nav-section-start {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--c-header-divider);
}

nav ul a {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--c-header-fg);
  font-family: var(--header-font);
  font-weight: bold;
  font-size: 1rem;
  text-decoration: none;
  position: relative;
  padding: 0.6rem 0; /* vertical rhythm; padding-left controlled by hover animation */
  transition: padding-left 0.25s ease;
}

nav ul a::before {
  content: '⫸'; /* → */
  color: var(--c-header-accent);
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%) translateX(-0.5em);
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
  font-size: 1em;
  line-height: 1;
}

nav ul a:hover {
  padding-left: 1.3em;
}

nav ul a:hover::before {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

social {
  display: flex;
  flex-direction: row;
  padding-top: 2em;
  gap: 2em;
  justify-content: center;
}

social a svg {
  flex-shrink: 0;
  display: block;
  width: 3rem;
  height: 3rem;
  margin-right: -0.2em;
}

/* =====================
   Desktop (≥800px): left sidebar column
   ===================== */

@media (min-width: 800px) {
  :host {
    display: flex;
    flex-direction: column;
    width: calc(300px + max(var(--header-pad-inline), env(safe-area-inset-left)));
    flex-shrink: 0;
    padding: var(--header-pad-block) var(--header-pad-inline);
    padding-left: max(var(--header-pad-inline), env(safe-area-inset-left));
    padding-top: max(var(--header-pad-block), env(safe-area-inset-top));
    padding-bottom: max(var(--header-pad-block), env(safe-area-inset-bottom));
    box-sizing: border-box;
    gap: 2rem;
    align-items: flex-start;
  }

  .hamburger {
    display: none;
  }

  nav {
    flex: 1;
    width: 100%;
    transform: none;
    visibility: visible;
    transition: none;
  }
}

/* =====================
   Mobile (<800px): sticky top banner + fullscreen overlay
   ===================== */

@media (max-width: 799px) {
  :host {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--header-pad-block) var(--header-pad-inline);
    padding-left: max(var(--header-pad-inline), env(safe-area-inset-left));
    padding-right: max(var(--header-pad-inline), env(safe-area-inset-right));
    padding-top: max(var(--header-pad-block), env(safe-area-inset-top));
    box-sizing: border-box;
    width: 100%;
  }

  :host::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--c-header-bg);
    z-index: 250; /* above nav (200), below logo + hamburger (300) */
  }

  :host::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.75rem;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent);
    pointer-events: none;
  }

  /* Logo elevated above nav panel during slide animation */
  /* min-width:0 + overflow:hidden prevent the logo from growing wider than the
     available flex space and overlapping the hamburger label, which would cause
     a click on the logo to also toggle the checkbox (menu flash). */
  .logo-link {
    position: relative;
    z-index: 300;
    min-width: 0;
    overflow: hidden;
  }

  /* Three-bar hamburger — animates to X when overlay is open */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.5rem;
    height: 1.25rem;
    cursor: pointer;
    flex-shrink: 0; /* never shrink toward the logo */
    position: relative;
    z-index: 300; /* above the overlay (z-index: 200) within the same stacking context */
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--c-header-fg);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  /* Bars morph into X */
  .nav-toggle:checked ~ .hamburger span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .nav-toggle:checked ~ .hamburger span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle:checked ~ .hamburger span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Slide-down nav panel — anchored just below the topbar */
  nav {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: calc(var(--logo-size) + 2 * var(--header-pad-block));
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--c-header-bg);
    z-index: 200;
    overflow-y: auto;
    padding: 1.5rem 2rem 2rem 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(2rem, env(safe-area-inset-right));
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    box-sizing: border-box;
    transform: translateY(-100%);
    visibility: hidden;
    transition: transform 0.2s ease, visibility 0s 0.2s;
  }

  .nav-toggle:checked ~ nav {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.2s ease;
  }

  /* Prevent the nav from animating its initial hidden state on page load.
     Without this, Blink fires the transition from default values
     (transform:none / visibility:visible) to the declared hidden state,
     producing a "roll-up" flash every time a page is loaded.
     @starting-style sets the before-change style = the resting style,
     so start === end and no transition plays on first paint. */
  @starting-style {
    nav {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
}

/* =====================
   Landscape + short viewport: reduce logo to save vertical space
   ===================== */

@media (max-width: 799px) and (max-height: 500px) {
  :host {
    --logo-size: 2.5rem;
  }
}
</style>

