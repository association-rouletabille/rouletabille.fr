          <icon name="Instagram"></icon>
          <span>rtb_monocycle</span>
        </a>
      </li>
      <li>
        <a href="https://www.facebook.com/rouletabillemonocycleparis" target="_blank" rel="noopener noreferrer">
          <icon name="2023_Facebook_icon"></icon>
          <span>rouletabillemonocycleparis</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style webc:scoped>
/* =====================
   Tokens
   ===================== */

:host {
  --c-header-bg: #f4f0e5;
  --palette-fg: 14, 14, 14;
  --c-header-fg: rgba(var(--palette-fg), 1);
  --c-header-accent: #e05c00;
  --c-header-muted: #555;
  --c-header-divider: rgba(var(--palette-fg), 0.15);
  --header-font: monospace;
  --logo-size: 4.5rem;
  --header-pad-block: 0.5rem;
  --header-pad-inline: 1rem;
}

/* =====================
   Shared
   ===================== */

:host {
  background-color: var(--c-header-bg);
  color: var(--c-header-fg);
}

.nav-toggle {
  display: none;
}

.logo-link {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--c-header-fg);
  text-decoration: none;
  flex-shrink: 0;
}

.logo-link svg {
  width: var(--logo-size);
  height: var(--logo-size);
  display: block;
}

.site-name-group {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.site-name {
  font-family: var(--header-font);
  font-size: 1.3rem;
  font-weight: bold;
  line-height: 1.2;
}

.site-subtitle {
  font-family: var(--header-font);
  font-size: 0.85rem;
  font-weight: normal;
  color: var(--c-header-muted);
  line-height: 1.3;
  margin-top: 0.25rem;
}

nav ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

nav li.nav-section-start {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid var(--c-header-divider);
}

nav a {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--c-header-fg);
  font-family: var(--header-font);
  font-weight: bold;
  font-size: 1rem;
  text-decoration: none;
  position: relative;
  padding: 0.6rem 0; /* vertical rhythm; padding-left controlled by hover animation */
  transition: padding-left 0.25s ease;
}

nav a::before {
  content: '⫸'; /* → */
  color: var(--c-header-accent);
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%) translateX(-0.5em);
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
  font-size: 1em;
  line-height: 1;
}

nav a:hover {
  padding-left: 1.3em;
}

nav a:hover::before {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

nav a svg {
  flex-shrink: 0;
  display: block;
  width: 1.4rem;
  height: 1.4rem;
  margin-right: -0.2em;
}

/* =====================
   Desktop (≥800px): left sidebar column
   ===================== */

@media (min-width: 800px) {
  :host {
    display: flex;
    flex-direction: column;
    width: 300px;
    flex-shrink: 0;
    padding: var(--header-pad-block) var(--header-pad-inline);
    box-sizing: border-box;
    gap: 2rem;
    align-items: flex-start;
  }

  .hamburger {
    display: none;
  }

  nav {
    flex: 1;
    width: 100%;
    transform: none;
    visibility: visible;
    transition: none;
  }
}

/* =====================
   Mobile (<800px): sticky top banner + fullscreen overlay
   ===================== */

@media (max-width: 799px) {
  :host {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--header-pad-block) var(--header-pad-inline);
    box-sizing: border-box;
    width: 100%;
  }

  :host::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--c-header-bg);
    z-index: 250; /* above nav (200), below logo + hamburger (300) */
  }

  :host::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.75rem;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent);
    pointer-events: none;
  }

  /* Logo elevated above nav panel during slide animation */
  .logo-link {
    position: relative;
    z-index: 300;
  }

  /* Three-bar hamburger — animates to X when overlay is open */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.5rem;
    height: 1.25rem;
    cursor: pointer;
    flex-shrink: 0;
    position: relative;
    z-index: 300; /* above the overlay (z-index: 200) within the same stacking context */
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--c-header-fg);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
    transform-origin: center;
  }

  /* Bars morph into X */
  .nav-toggle:checked ~ .hamburger span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .nav-toggle:checked ~ .hamburger span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle:checked ~ .hamburger span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* Slide-down nav panel — anchored just below the topbar */
  nav {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: calc(var(--logo-size) + 2 * var(--header-pad-block));
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--c-header-bg);
    z-index: 200;
    overflow-y: auto;
    padding: 1.5rem 2rem 2rem 1rem;
    box-sizing: border-box;
    transform: translateY(-100%);
    visibility: hidden;
    transition: transform 0.2s ease, visibility 0s 0.2s;
  }

  .nav-toggle:checked ~ nav {
    transform: translateY(0);
    visibility: visible;
    transition: transform 0.2s ease;
  }
}
</style>

