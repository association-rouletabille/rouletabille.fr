<header webc:root="override">
  <a href="/" class="logo-link" aria-label="Accueil">
    <icon name="logo"></icon>
    <div class="site-name-group">
      <span class="site-name">Monocycle</span>
      <span class="site-subtitle">Paris / Île de France</span>
    </div>
  </a>

  <!-- Hidden checkbox — pure-CSS toggle, no JS -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />

  <!-- Hamburger (three bars): visible on mobile only -->
  <label for="nav-toggle" class="hamburger" aria-label="Menu">
    <span></span>
    <span></span>
    <span></span>
  </label>

  <!-- Navigation: same HTML for sidebar (desktop) and overlay (mobile) -->
  <nav aria-label="Navigation principale">
    <ul>
      <li><a href="/association">L'association</a></li>
      <li class="nav-section-start"><a href="/initiations-monocycle-gratuites">Initiations gratuites</a></li>
      <li><a href="/balades-du-mardi-soir">Balades du Mardi Soir</a></li>
      <li><a href="/trial-street-flat">Trial, street et flat</a></li>
      <li><a href="/roule-ton-caillou">Roule Ton Caillou</a></li>
      <li class="nav-section-start"><a href="/tutoriels-et-resources">Tutoriels et resources</a></li>
      <li class="nav-section-start"><a href="/adhesion">Adh&eacute;rer</a></li>
    </ul>
    <social>
      <a href="mailto:association.rouletabille@gmail.com?subject=Contact%20depuis%20le%20site%20web">
        <icon name="email"></icon>
      </a>
      <a href="https://www.instagram.com/rtb_monocycle" target="_blank" rel="noopener noreferrer">
        <icon name="Instagram"></icon>
      </a>
      <a href="https://www.facebook.com/rouletabillemonocycleparis" target="_blank" rel="noopener noreferrer">
        <icon name="2023_Facebook_icon"></icon>
      </a>
    </social>
  </nav>
</header>

<style webc:scoped>
  /* =====================
   Shared (all viewports)
   ===================== */

  :host {
    background-color: rgb(var(--palette-nav-bg));
    color: rgb(var(--palette-nav-fg));
  }

  .nav-toggle {
    display: none;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
    min-width: 0;
    overflow: hidden;
  }

  .logo-link svg {
    width: var(--logo-size);
    height: var(--logo-size);
    display: block;
    flex-shrink: 0;
  }

  .site-name-group {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
  }

  .site-name {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: bold;
    line-height: 1.2;
  }

  .site-subtitle {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: rgb(var(--palette-nav-dim));
    line-height: 1.3;
    margin-top: 0.25rem;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  nav li.nav-section-start {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(var(--palette-nav-fg), 0.15);
  }

  nav ul a {
    display: flex;
    align-items: center;
    color: rgb(var(--palette-nav-fg));
    font-family: var(--font-mono);
    font-weight: bold;
    font-size: var(--fs-base);
    text-decoration: none;
    position: relative;
    padding: 0.6rem 0;
    transition: padding-left 0.25s ease;
  }

  nav ul a::before {
    content: '⫸';
    color: rgb(var(--palette-accent));
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) translateX(-0.5em);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    pointer-events: none;
    font-size: 1em;
    line-height: 1;
  }

  nav ul a:hover {
    padding-left: 1.3em;
  }

  nav ul a:hover::before {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  social {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 2rem;
    padding-top: 2rem;
  }

  social a svg {
    display: block;
    width: 3rem;
    height: 3rem;
  }

  /* =====================
   Desktop (≥800px): left sidebar
   ===================== */

  @media (min-width: 800px) {
    :host {
      display: flex;
      flex-direction: column;
      width: var(--sidebar-w);
      padding: var(--safe-top) 1rem var(--safe-bottom) var(--safe-left);
      gap: 2rem;
      align-items: flex-start;
      box-shadow: -4px 0 12px rgba(var(--palette-nav-fg), 0.2);
    }

    .hamburger {
      display: none;
    }

    nav {
      flex: 1;
      width: 100%;
    }
  }

  /* =====================
   Mobile (<800px): sticky top bar + overlay nav
   ===================== */

  @media (max-width: 799px) {
    :host {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
      width: 100%;
      padding: var(--safe-top) var(--safe-right) var(--header-pad-block) var(--safe-left);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    }

    .logo-link {
      min-width: 0;
      overflow: hidden;
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 1.5rem;
      height: 1.25rem;
      cursor: pointer;
      flex-shrink: 0;
    }

    .hamburger span {
      display: block;
      width: 100%;
      height: 2px;
      background-color: currentColor;
      border-radius: 2px;
      transform-origin: center;
      transition:
        transform 0.25s ease,
        opacity 0.2s ease;
    }

    .nav-toggle:checked ~ .hamburger span:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }

    .nav-toggle:checked ~ .hamburger span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle:checked ~ .hamburger span:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }

    /* Nav overlay — positioned below the sticky header, hidden by default */
    nav {
      display: none;
      position: fixed;
      top: var(--header-h);
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 5;
      background-color: rgb(var(--palette-nav-bg));
      overflow-y: auto;
      padding: 1.5rem var(--safe-right) var(--safe-bottom) var(--safe-left);
    }

    .nav-toggle:checked ~ nav {
      display: flex;
      flex-direction: column;
    }
  }

  /* =====================
   Landscape + short viewport: shrink logo to save vertical space.
   CSS lazy substitution auto-corrects --header-h on all descendants.
   ===================== */

  @media (max-width: 799px) and (max-height: 500px) {
    :host {
      --logo-size: 2.5rem;
    }
  }
</style>
