<footer webc:root="override">
  <icon name="unicycle"></icon>
  <ul>
    <li>
      <a href="https://www.instagram.com/rtb_monocycle" target="_blank" rel="noopener noreferrer">
        <icon name="Instagram"></icon>
        <span>rtb_monocycle</span>
      </a>
    </li>
    <li>
      <a href="https://www.facebook.com/rouletabillemonocycleparis" target="_blank" rel="noopener noreferrer">
        <icon name="Facebook"></icon>
        <span>rouletabillemonocycleparis</span>
      </a>
    </li>
  </ul>
</footer>

<style webc:scoped>
  :host {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-block: 0 max(4rem, env(safe-area-inset-bottom));
  }

  :host > svg {
    display: block;
    width: 5rem;
    height: 5rem;
  }

  :host ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  :host a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :host a svg {
    flex-shrink: 0;
    display: block;
    width: 1.4rem;
    height: 1.4rem;
  }
</style>

<script>
  document.querySelector('footer').addEventListener('click', (event) => {
    const svg = event.target.closest('.icon-unicycle');

    if (!svg || svg.classList.contains('trick')) {
      return;
    }

    // The hover spin is linear, so its progress *is* the fraction of a turn the
    // cranks have reached; hand it to CSS so they wind down from where they are.
    const [spin] = svg.querySelector('.unicycle-cranks').getAnimations();
    const from = spin ? spin.effect.getComputedTiming().progress : 1;

    svg.style.setProperty('--crank-from', `${from}turn`);
    svg.classList.add('trick');

    // Infinite animations never resolve `finished`, and under reduced motion
    // there is nothing to wait for, so the trick ends on the next microtask.
    const running = svg.getAnimations({ subtree: true }).filter((animation) => animation.effect.getComputedTiming().iterations !== Infinity);

    Promise.allSettled(running.map((animation) => animation.finished)).then(() => {
      svg.classList.remove('trick');
      svg.style.removeProperty('--crank-from');
    });
  });
</script>
