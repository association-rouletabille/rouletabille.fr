<footer webc:root="override">
  <span class="unicycle-toy">
    <icon name="unicycle"></icon>
    <span class="trick-count" aria-hidden="true" hidden></span>
  </span>
  <ul>
    <li>
      <a href="https://www.instagram.com/rtb_monocycle" target="_blank" rel="noopener noreferrer">
        <icon name="Instagram"></icon>
        <span>rtb_monocycle</span>
      </a>
    </li>
    <li>
      <a href="https://www.facebook.com/rouletabillemonocycleparis" target="_blank" rel="noopener noreferrer">
        <icon name="Facebook"></icon>
        <span>rouletabillemonocycleparis</span>
      </a>
    </li>
  </ul>
</footer>

<style webc:scoped>
  :host {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-block: 0 max(4rem, env(safe-area-inset-bottom));
  }

  :host > .unicycle-toy {
    position: relative;
    display: block;
    width: 5rem;
    height: 5rem;
  }

  /* Positioned so it stacks over the absolutely placed badge. */
  :host .unicycle-toy > svg {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  :host .trick-count {
    position: absolute;
    top: -0.3rem;
    left: -0.3rem;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgb(var(--palette-accent));
    color: rgb(var(--palette-bright));
    font-weight: 700;
    font-size: 1rem;
    line-height: 1;
  }

  :host .trick-count[hidden] {
    display: none;
  }

  /* Two rings blown outwards from under the badge, the second a beat later. */
  :host .trick-count::before,
  :host .trick-count::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 0.2rem solid rgb(var(--palette-accent));
    border-radius: 50%;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :host .trick-count.pop {
      animation: trick-count-pop 0.5s cubic-bezier(0.2, 1.7, 0.4, 1) both;
    }

    :host .trick-count.pop::before {
      animation: trick-count-burst 0.55s ease-out both;
    }

    :host .trick-count.pop::after {
      animation: trick-count-burst 0.55s ease-out 0.12s both;
    }
  }

  @keyframes trick-count-pop {
    0% {
      scale: 0.2;
      rotate: -25deg;
      opacity: 0;
    }
    45% {
      scale: 1.4;
      rotate: 10deg;
      opacity: 1;
    }
    70% {
      scale: 0.88;
      rotate: -5deg;
    }
    100% {
      scale: 1;
      rotate: 0deg;
      opacity: 1;
    }
  }

  @keyframes trick-count-burst {
    from {
      scale: 0.9;
      opacity: 0.9;
    }
    to {
      scale: 2.8;
      opacity: 0;
    }
  }

  :host ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  :host a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :host a svg {
    flex-shrink: 0;
    display: block;
    width: 1.4rem;
    height: 1.4rem;
  }
</style>

<script>
  (() => {
    const footer = document.querySelector('footer');
    const svg = footer.querySelector('.icon-unicycle');
    const counter = footer.querySelector('.trick-count');

    // One click per step of the countdown, then the sequence starts over.
    const tricks = [
      { classes: ['trick-roll'], count: 3 },
      { classes: ['trick-idle'], count: 2 },
      { classes: ['trick-hop'], count: 1 },
    ];
    let step = 0;

    footer.addEventListener('click', (event) => {
      if (!event.target.closest('.unicycle-toy') || svg.classList.contains('trick')) {
        return;
      }

      const trick = tricks[step];
      step = (step + 1) % tricks.length;

      svg.classList.add('trick', ...trick.classes);

      // Under reduced motion there is nothing to wait for, so the trick ends on
      // the next microtask.
      const running = svg.getAnimations({ subtree: true });

      Promise.allSettled(running.map((animation) => animation.finished)).then(() => {
        svg.classList.remove('trick', ...trick.classes);

        counter.textContent = trick.count;
        counter.hidden = false;
        counter.classList.remove('pop');
        void counter.offsetWidth; // Forced reflow so the pop replays on every landing.
        counter.classList.add('pop');
      });
    });
  })();
</script>
