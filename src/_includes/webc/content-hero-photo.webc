<figure webc:root="override" class="content-hero-photo">
  <div class="photo">
    <!---
      sizes = rendered width of .photo, which equals main's border box (the negative
      margins below cancel main's inline padding):
        < 800px  : single column, main is full width           -> 100vw
        800-1100 : grid "300px 1fr", column not yet capped      -> 100vw - 300px
        >= 1100  : body capped at 300px + 100ch, so main = 100ch -> 800px
      100ch is hardcoded as 800px because font-relative units in `sizes` resolve
      against the root font, not main's system-ui font.
    --->
    <img :src="this.src" :alt="this.alt" sizes="(min-width: 1100px) 800px, (min-width: 800px) calc(100vw - 300px), 100vw" fetchpriority="high" loading="eager" decoding="sync" />
  </div>
</figure>

<!--- object-position is generated server-side into scoped CSS (not an inline style
      attribute) so it complies with a `style-src 'self'` Content-Security-Policy. --->
<script webc:type="js" webc:is="style" webc:scoped>
  `
  :host {
    display: block;
    margin: 0;
  }

  .photo {
    height: clamp(10rem, 27vw, 17.85rem);
    margin-inline: calc(-1 * var(--safe-left)) calc(-1 * var(--safe-right));
    overflow: hidden;
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: ${this.position};
  }
`;
</script>
