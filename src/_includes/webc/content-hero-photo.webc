<figure webc:root="override" class="content-hero-photo">
  <div class="photo">
    <img :src="this.src" :alt="this.alt" decoding="async" fetchpriority="high" />
  </div>
</figure>

<style webc:scoped>
  :host {
    display: block;
    margin: 0 0 1.75rem;
  }

  .photo {
    height: clamp(10rem, 27vw, 17.85rem);
    margin-inline: calc(-1 * var(--safe-left)) calc(-1 * var(--safe-right));
    overflow: hidden;
  }

  .photo img {
    display: block;
    width: 100%;
