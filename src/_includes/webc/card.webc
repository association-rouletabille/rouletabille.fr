<!--- The id is the one <table-of-contents> links to. --->
<section webc:root="override" :id="this.heading && $data.site.sectionId(this.heading)">
  <h2 webc:if="this.heading" @text="this.heading"></h2>
  <slot></slot>
</section>

<style webc:scoped>
  :host {
    display: block;
    margin-block: 2.5rem;
    padding: 1.25rem 1.5rem;
    background-color: rgb(var(--palette-content-surface));
    border: 1px solid rgba(var(--palette-nav-dim), 0.1);
    border-radius: 0.4rem;
    box-shadow: 0 0.4rem 0.55rem 0.2rem rgba(var(--palette-nav-fg), 0.05);
    scroll-margin-top: 1rem;
  }

  /* Keeps a card reached through a link clear of the sticky header. */
  @media (max-width: 799px) {
    :host {
      scroll-margin-top: calc(var(--safe-top) + var(--logo-size) + var(--header-pad-block) + 1rem);
    }
  }

  :host > h2 {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    font-weight: bold;
    color: rgb(var(--palette-accent-secondary));
    margin-block: 0 0.75rem;
    line-height: 1.3;
  }
</style>
