---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<template webc:nokeep @raw='"<?xml version=\"1.0\" encoding=\"utf-8\" ?>"'></template>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url webc:for="page of collections.all">
    <loc @text="$data.site.url(page.url)"></loc>
    <lastmod @text="(new Date(page.date ?? undefined)).toISOString()"></lastmod>
    <changefreq @text="page.data.changeFreq ?? 'monthly'"></changefreq>
  </url>
</urlset>
