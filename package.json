{
  "name": "rouletabille.fr",
  "version": "0.0.1",
  "repository": "https://github.com/association-rouletabille/rouletabille.fr.git",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-directory-output": "^1.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@eslint/js": "^10.0.1",
    "@minify-html/node": "^0.18.1",
    "eleventy-plugin-icons": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turndown": "^7.2.4",
    "vitest": "^5.0.2",
    "wrangler": "^4.131.0"
  },
  "scripts": {
    "build:dist": "COMMIT_SHA=$(git rev-parse HEAD) npx @11ty/eleventy",
    "build:dev": "npx @11ty/eleventy",
    "clean": "npx rimraf dist",
    "serve": "npx @11ty/eleventy --serve",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "lint": "npx eslint . --cache --cache-location .cache/ --fix",
    "lint:ci": "npx eslint . --max-warnings=0",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "lint-staged": "npx lint-staged",
    "prepare": "npx husky"
  },
  "lint-staged": {
    "(*.js|*.css|*.html|*.md|*.webc)": [
      "npm run lint",
      "npm run format"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260910.1": true
  }
}
