{
  "name": "rouletabille.fr",
  "version": "0.0.1",
  "repository": "https://github.com/association-rouletabille/rouletabille.fr.git",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@eslint/js": "^9.38.0",
    "@minify-html/node": "^0.18.1",
    "eleventy-plugin-icons": "^4.5.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lightningcss": "^1.30.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "sass": "^1.94.2",
    "wrangler": "^4.54.0"
  },
  "scripts": {
    "build": "COMMIT_SHA=$(git rev-parse HEAD) npx @11ty/eleventy",
    "lint": "npx eslint . --cache --cache-location .cache/ --fix",
    "format": "npx prettier . --write",
    "lint-staged": "npx lint-staged",
    "prepare": "npx husky"
  },
  "lint-staged": {
    "(*.js|*.css|*.html|*.md)": [
      "npm run lint",
      "npm run format"
    ]
  }
}
